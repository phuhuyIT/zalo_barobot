{
  "name": "zalo-barobot",
  "version": "1.0.0",
  "description": "Automated System for Sending Squad Duty Schedules via Zalo",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc",
    "start": "node dist/supervisor.js",
    "start:bot": "node dist/index.js",
    "start:worker": "node dist/taskproof/worker/index.js",
    "dev": "tsx watch src/index.ts",
    "dev:worker": "tsx watch src/taskproof/worker/index.ts",
    "dev:all": "tsx src/supervisor.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint .",
    "format": "prettier --write .",
    "set-webhook": "tsx scripts/setWebhook.ts",
    "delete-webhook": "tsx scripts/deleteWebhook.ts",
    "reset:patrol": "tsx scripts/resetPatrol.ts",
    "reset:schedule": "tsx scripts/resetSchedule.ts",
    "reset:all": "tsx scripts/resetAll.ts",
    "get-chat-id": "tsx scripts/getChatId.ts"
  },
  "dependencies": {
    "axios": "^1.20.0",
    "better-sqlite3": "^13.0.3",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "googleapis": "^178.1.1",
    "js-yaml": "^5.4.1",
    "node-cron": "^4.6.0",
    "sharp": "^0.35.4",
    "zca-js": "^2.2.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/better-sqlite3": "^9.6.0",
    "@types/express": "^5.0.6",
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^26.5.0",
    "@types/node-cron": "^3.0.11",
    "eslint": "^10.10.0",
    "prettier": "^3.9.7",
    "tsx": "^4.23.13",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.70.0",
    "vitest": "^5.0.0"
  }
}
