# Server Configuration
PORT=3000
NODE_ENV=development
TZ=Asia/Ho_Chi_Minh

# Authentication for Web UI (official names — do not rename to WEB_UI_USER / WEB_UI_PASSWORD)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change_this_password

# Zalo Bot API
ZALO_BOT_TOKEN=your_zalo_bot_token_here
ZALO_WEBHOOK_SECRET=your_webhook_secret_token

# Recipient Chat IDs (referenced in config/schedules.yaml)
ADMIN_CHAT_ID=your_admin_chat_id
SQUAD_MAIN_CHAT_ID=your_main_squad_chat_id
SQUAD_CULI_CHAT_ID=your_culi_squad_chat_id
PLATOON_LEADER_CHAT_ID=your_platoon_leader_chat_id
SQUAD_PARTNER_CHAT_ID=your_partner_squad_chat_id
PARTNER_LEADER_USER_ID=your_partner_squad_leader_user_id

# Patrol Feature Configuration (Tiểu đội 1 đi tuần & nhắc nhở)
TIUDOI_1_LEADER_USER_ID=your_squad_1_leader_user_id
# Trụ sở 1: người báo cáo thứ hai. Khi có giá trị này (hoặc nhập trên Web UI),
# bot chờ đủ hai lệnh tuantra rồi mới ghép lịch. Trụ sở 2 vẫn một người.
SITE_1_LEADER_2_USER_ID=your_headquarters_1_second_reporter_user_id
PATROL_GROUP_ID=your_patrol_group_chat_id

# Google Sheets API
GOOGLE_SHEET_ID=your_google_spreadsheet_id
# Provide either the file path to service account credentials JSON or inline JSON string
GOOGLE_APPLICATION_CREDENTIALS=./service-account.json
# Or inline JSON:
# GOOGLE_SERVICE_ACCOUNT_JSON={"type":"service_account",...}

# Database
# For Railway, mount volume at /data and set DATABASE_PATH=/data/app.db
DATABASE_PATH=./data/app.db

# Configuration File
CONFIG_PATH=./config/schedules.yaml

# Internal token for POST /internal/run-due-jobs and task-proof
# coordination / short-lived photo+QR URLs (query ?key=).
# Official name — do not rename to INTERNAL_CRON_TOKEN.
INTERNAL_API_KEY=your_internal_cron_secret_key

# Public https origin (no trailing slash) that Zalo can fetch for sendPhoto.
# Production: https://zalobarobot-production.up.railway.app
# Codespace:  https://fluffy-space-system-gw969qq4x65hq9q-3000.app.github.dev
PUBLIC_BASE_URL=https://zalobarobot-production.up.railway.app

# Task-proof worker (zca-js). Localhost only; not public.
TASKPROOF_WORKER_PORT=3001
ZCA_SESSION_FILE_PATH=/data/zca-session.json
PROOF_DIR=/data/proofs
