# Server Configuration
PORT=3000
NODE_ENV=development

# Authentication for Web UI
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change_this_password

# Zalo Bot API
ZALO_BOT_TOKEN=your_zalo_bot_token_here
ZALO_WEBHOOK_SECRET=your_webhook_secret_token

# Recipient Chat IDs (referenced in config/schedules.yaml)
ADMIN_CHAT_ID=your_admin_chat_id
SQUAD_MAIN_CHAT_ID=your_main_squad_chat_id
SQUAD_CULI_CHAT_ID=your_culi_squad_chat_id
PLATOON_LEADER_CHAT_ID=your_platoon_leader_chat_id

# Google Sheets API
GOOGLE_SHEET_ID=your_google_spreadsheet_id
# Provide either the file path to service account credentials JSON or inline JSON string
GOOGLE_APPLICATION_CREDENTIALS=./service-account.json
# Or inline JSON:
# GOOGLE_SERVICE_ACCOUNT_JSON={"type":"service_account",...}

# Database
# For Railway, mount volume at /data and set DATABASE_PATH=/data/app.db
DATABASE_PATH=./data/app.db

# Configuration File
CONFIG_PATH=./config/schedules.yaml

# Internal Railway Cron Secret for POST /internal/run-due-jobs
INTERNAL_API_KEY=your_internal_cron_secret_key
